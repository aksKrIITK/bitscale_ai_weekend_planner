# Perfect Saturday Planner Environment Configuration

# Groq LLM API Key (Optional: App includes deterministic synthesis fallback if empty)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Name
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Connection URL
# For Docker Compose: postgresql://postgres:postgrespassword@postgres:5432/saturday_planner
# For local SQLite fallback: sqlite:///./saturday_planner.db
DATABASE_URL=sqlite:///./saturday_planner.db

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

# pgvector semantic search flag
USE_PGVECTOR=false
